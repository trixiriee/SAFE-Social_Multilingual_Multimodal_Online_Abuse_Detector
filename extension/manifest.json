{
  "manifest_version": 3,
  "name": "Cyberbullying Filter",
  "version": "1.0",
  "description": "Detects and filters cyberbullying content using a local ML backend.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
